{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m ruff check*)",
      "Bash(.venv/Scripts/pytest*)",
      "Bash(.venv/Scripts/ruff check*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m ruff check*)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv-floor/Scripts/python.exe -m pytest*)",
      "Bash(.venv-floor/Scripts/pytest*)",
      "Bash(.venv-floor/bin/python -m pytest*)",
      "Bash(.venv-floor/bin/pytest*)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch --quiet origin 2>/dev/null; behind=$(git rev-list --count HEAD..origin/main 2>/dev/null); if [ -n \"$behind\" ] && [ \"$behind\" -gt 0 ]; then echo \"NOTE: this checkout is $behind commit(s) behind origin/main. Check before planning changes - work built on a stale base may need rebasing.\"; fi",
            "timeout": 20,
            "statusMessage": "Checking against origin/main"
          }
        ]
      }
    ]
  }
}
