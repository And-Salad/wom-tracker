# Make an unsupported Node say so.
#
# npm treats a package's `engines` as advice by default, so jsdom 30 installed
# happily on Node 20 and then failed at require time inside undici with
# `webidl.util.markAsUncloneable is not a function` - an error naming neither
# jsdom, nor Node, nor the version of either. This turns that into a refusal
# at install time, which is the point at which it is still cheap to read.
engine-strict=true
